{
  "name": "@ousi-ui/registry",
  "version": "0.1.0",
  "description": "Component and theme registry metadata for Ousi UI CLI",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.json"
  ],
  "scripts": {
    "build": "echo \"skip: registry build not configured\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@ousi-ui/tsconfig": "workspace:*",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  }
}
