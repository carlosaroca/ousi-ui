{
  "name": "@ousi-ui/tokens",
  "version": "0.1.2",
  "description": "Design tokens for Ousi UI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@ousi-ui/tsconfig": "workspace:*",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carlosaroca/ousi-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://ousiui.com",
  "license": "MIT",
  "author": "Carlos Aroca <hello@carlosaroca.com> (https://carlosaroca.com)",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui-library",
    "tailwindcss",
    "typescript",
    "design-system",
    "ousi-ui"
  ]
}
