{
  "name": "@ousi-ui/vue",
  "version": "0.1.0",
  "description": "Vue 3 components for Ousi UI",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ousi-ui/core": "workspace:*",
    "@ousi-ui/haptics": "workspace:*",
    "@floating-ui/vue": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "motion-v": "^1.0.0"
  },
  "peerDependencies": {
    "@ousi-ui/theme": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@ousi-ui/tsconfig": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carlosaroca/ousi-ui.git",
    "directory": "packages/vue"
  },
  "homepage": "https://ousiui.com",
  "license": "MIT",
  "author": "Carlos Aroca <hello@carlosaroca.com> (https://carlosaroca.com)",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui-library",
    "tailwindcss",
    "typescript",
    "design-system",
    "ousi-ui"
  ]
}
